# Environment template for the AgriTrust backend.
# Copy to `.env` and adjust. `cp .env.example .env`
#
# Security (DJANGO_SECRET_KEY is required when DJANGO_DEBUG=0)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (matches docker-compose.yml)
POSTGRES_DB=agritrust
POSTGRES_USER=agritrust
POSTGRES_PASSWORD=agritrust
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sessions & CSRF (set to 1 over HTTPS in production)
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
CSRF_TRUSTED_ORIGINS=http://localhost:5173
